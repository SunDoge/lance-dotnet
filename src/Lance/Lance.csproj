<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>SunDoge.Lance</PackageId>
    <AssemblyName>SunDoge.Lance</AssemblyName>
    <RootNamespace>SunDoge.Lance</RootNamespace>
    <Version>0.1.0-preview.1</Version>
    <Authors>SunDoge</Authors>
    <Description>C# bindings for the Lance dataset engine via lance-c, with Apache Arrow streaming and object storage support.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Apache.Arrow" Version="22.1.0" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../native/LICENSE" Pack="true" PackagePath="licenses/lance-c/" />
    <None Remove="runtimes/**/*" />
    <None Include="runtimes/**/*" Pack="true" PackagePath="%(Identity)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="ValidateNativeAssets" BeforeTargets="GenerateNuspec" Condition="'$(AllowMissingNativeAssets)' != 'true'">
    <ItemGroup>
      <_NativeLibraries Include="runtimes/**/*.so;runtimes/**/*.dylib;runtimes/**/*.dll" />
    </ItemGroup>
    <Error Condition="'@(_NativeLibraries)' == ''" Text="No native libraries found. Run python3 tools/fetch_native.py --rid &lt;rid&gt; before packing, or explicitly set AllowMissingNativeAssets=true for a managed-only package." />
  </Target>
</Project>
